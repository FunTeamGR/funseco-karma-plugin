{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "funseco/karma-plugin",
    "description": "Funseco karma — track votes, widget, mania-karma.com sync",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "funseco/core": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Funseco\\Karma\\": "src/"
        }
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Funseco\\Karma\\Tests\\": "tests/"
        }
    },
    "extra": {
        "funseco": {
            "id": "karma",
            "name": "Karma",
            "description": "karma — track votes, widget, mania-karma.com sync",
            "provider": "Funseco\\Karma\\KarmaServiceProvider"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
